<Window x:Class="BorDer_PR18_01._01.EnterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR18_01._01"
        mc:Ignorable="d"
        Title="Вход" Height="320" Width="300"
        FontFamily="Comic Sans MS" FontSize="14"
        Closing="Window_Closing">
    <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Center">
        <TextBlock Text="Логин" Padding="5"/>
        <TextBox x:Name="textBoxLogin" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Пароль" Padding="5" Margin="0,5,0,0"/>
        <WrapPanel Orientation="Horizontal">
            <PasswordBox x:Name="passwordBoxPassword" Padding="5" Width="165" Background="#76E383"/>
            <TextBox x:Name="textBoxPassword" Padding="5" Width="165" Background="#76E383" Visibility="Collapsed"/>
            <ToggleButton Content="*" VerticalAlignment="Center" Padding="5" Width="30" Margin="5,0,0,0" Click="ToggleButton_Click"/>
        </WrapPanel>

        <StackPanel x:Name="captchaBlock" Orientation="Vertical" Visibility="Collapsed">
            <TextBlock Text="Пароль введен неверно." TextAlignment="Center" Foreground="Red"/>
            <TextBlock Text="Введите капчу и попробуйте снова" TextAlignment="Center" Foreground="Red"/>

            <WrapPanel Orientation="Horizontal">
                <TextBlock x:Name="captchaText" Text="tEsT" Padding="5" FontSize="20" Background="#498C51" FontStretch="Medium" Width="80" TextAlignment="Center" TextDecorations="Strikethrough"/>
                <TextBox x:Name="textBoxCaptcha" Padding="5" Width="120"/>
            </WrapPanel>
            <Button Content="Сменить капчу" Padding="5" Width="100" Margin="5" x:Name="buttonChangeCaptcha" Click="buttonChangeCaptcha_Click"/>
        </StackPanel>

        <TextBlock x:Name="tmrTime" TextAlignment="Center" Foreground="Red" Padding="5" Text="00:00" Visibility="Collapsed"/>
        <Button Padding="5" Margin="15" Content="Вход" x:Name="buttonEnter" Click="buttonEnter_Click"/>

        <Button Padding="5" Margin="15,5,15,15" Content="Зарегистрироваться" x:Name="buttonRegister" Click="buttonRegister_Click"/>

        
    </StackPanel>
</Window>
