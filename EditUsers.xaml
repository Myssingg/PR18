<Window x:Class="BorDer_PR18_01._01.EditUsers"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR18_01._01"
        mc:Ignorable="d"
        Title="Редактирование пользователя" Height="450" Width="800"
        FontFamily="Comic Sans MS" FontSize="14">
    <StackPanel Orientation="Horizontal" Margin="10" HorizontalAlignment="Center">
        <StackPanel Orientation="Vertical" Margin="5,5,0,5">
            <TextBlock Text="Фамилия" Padding="5" HorizontalAlignment="Right"/>
            <TextBlock Text="Имя" Padding="5" Margin="0,13,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Отчество" Padding="5" Margin="0,13,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Email" Padding="5" Margin="0,12,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Логин" Padding="5" Margin="0,12,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Пароль" Padding="5" Margin="0,11,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Роль" Padding="5" Margin="0,11,0,0" HorizontalAlignment="Right"/>
            <TextBlock Text="Статус" Padding="5" Margin="0,10,0,0" HorizontalAlignment="Right"/>
        </StackPanel>
        <StackPanel Orientation="Vertical">
        <TextBox Text="{Binding surname}" 
                 TextWrapping="Wrap" 
                 Name="surname" 
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 Width="200"
                 Padding="5"
                 Margin="5"
                 VerticalContentAlignment="Center"/>

        <TextBox Text="{Binding name}" 
                TextWrapping="Wrap" 
                Name="name" 
                TextAlignment="Center" 
                FontWeight="SemiBold" 
                Width="200"
                Padding="5"
                VerticalContentAlignment="Center"
                Margin="5"/>

        <TextBox Text="{Binding patronymic}" 
                TextWrapping="Wrap" 
                Name="patronymic" 
                TextAlignment="Center" 
                FontWeight="SemiBold" 
                Width="200"
                Padding="5"
                VerticalContentAlignment="Center"
                 Margin="5"/>


        <TextBox Text="{Binding email}" 
                 TextWrapping="Wrap" 
                 Name="email" 
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 Width="200"
                 Padding="5"
                 Margin="5"
                 VerticalContentAlignment="Center"/>

        <TextBox Text="{Binding login}" 
                 TextWrapping="Wrap" 
                 Name="login" 
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 Width="200"
                 Padding="5"
                 VerticalContentAlignment="Center"
                 Margin="5"/>

        <TextBox Text="{Binding password}" 
                 TextWrapping="Wrap" 
                 Name="password" 
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 Width="200"
                 Padding="5"
                 Margin="5"
                 VerticalContentAlignment="Center"/>


        <ComboBox x:Name="roleId" Width="200" Padding="5" 
                  DisplayMemberPath="name"
                  Margin="5"
                  VerticalContentAlignment="Center"/>
        
        <ComboBox x:Name="status" Width="200" Padding="5" 
             DisplayMemberPath="name"
             Margin="5"
             VerticalContentAlignment="Center"/>
        
        <Button Padding="5" 
                Content="Редактировать" 
                x:Name="button_edit" 
                Click="button_edit_Click" 
                Margin="5"
                Background="#498C51"/>


        </StackPanel>
    </StackPanel>
</Window>
