<Window x:Class="BorDer_PR18_01._01.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR18_01._01"
        mc:Ignorable="d"
        Title="Регистрация" Height="auto" Width="300"
        FontFamily="Comic Sans MS" FontSize="14">
    <StackPanel Orientation="Vertical" Margin="10" HorizontalAlignment="Center">
        <TextBlock Text="Фамилия" Padding="5"/>
        <TextBox x:Name="textBoxSurname" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Имя" Padding="5"/>
        <TextBox x:Name="textBoxName" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Отчество" Padding="5"/>
        <TextBox x:Name="textBoxPatronymic" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Email" Padding="5"/>
        <TextBox x:Name="textBoxEmail" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Логин" Padding="5"/>
        <TextBox x:Name="textBoxLogin" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Пароль" Padding="5" Margin="0,5,0,0"/>
        <TextBox x:Name="textBoxPassword" Padding="5" Width="200" Background="#76E383"/>

        <TextBlock Text="Повторите пароль" Padding="5" Margin="0,5,0,0"/>
        <TextBox x:Name="textBoxConfirmPassword" Padding="5" Width="200" Background="#76E383"/>

        <Button Content="Регистрация" Click="Button_Click" Background="#498C51" Padding="5" Margin="15"/>
    </StackPanel>
</Window>
