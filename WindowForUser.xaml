<Window x:Class="BorDer_PR18_01._01.WindowForUser"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR18_01._01"
        mc:Ignorable="d"
        Title="WindowForUser" Height="600" Width="950"
    FontFamily="Comic Sans MS" FontSize="14">
    <TabControl Background="Azure" Margin="10">
        <TabControl.Template>
            <ControlTemplate TargetType="TabControl">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- 1. Верхняя панель (Заголовки + Кнопка) -->
                    <DockPanel Grid.Row="0" LastChildFill="False">
                        <!-- Место, где WPF рисует ваши TabItem (Товары, Заказы) -->
                        <TabPanel IsItemsHost="True" DockPanel.Dock="Left" VerticalAlignment="Bottom" />

                        <!-- Ваша реальная кнопка "Выйти" справа -->
                        <Button Content="Выйти" 
                        Click="TabItem_Click" 
                        DockPanel.Dock="Right" 
                        Margin="0,0,5,0" 
                        Padding="10,2"
                        Background="#76E383" />
                    </DockPanel>

                    <!-- 2. Область контента (само содержимое вкладок) -->
                    <Border Grid.Row="1" BorderBrush="LightGray" BorderThickness="0,1,0,0">
                        <ContentPresenter ContentSource="SelectedContent" />
                    </Border>
                </Grid>
            </ControlTemplate>
        </TabControl.Template>

        <TabItem Visibility="Collapsed">
            <StackPanel Orientation="Horizontal" 
            Margin="20" 
            Background="AliceBlue" 
            MinWidth="450">
                <ListView x:Name="listView" 
              Margin="20" 
              SelectionChanged="listView_SelectionChanged" >
                    <ListView.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="3" 
                             HorizontalAlignment="Center"/>
                        </ItemsPanelTemplate>
                    </ListView.ItemsPanel>


                    <ListView.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Vertical" 
                            Margin="5"
                            HorizontalAlignment="Center">
                                <Image Source="{Binding image.Image}" 
                                    Width="120" 
                                    Height="120"
                                    Stretch="Uniform" 
                                    HorizontalAlignment="Center"
                                    Margin="5"/>
                                <TextBlock Text="{Binding name}" 
                               TextWrapping="Wrap" 
                               TextAlignment="Center" 
                               FontWeight="SemiBold" 
                               MaxWidth="150"
                               HorizontalAlignment="Center"/>
                      
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>

                <Grid Width="300" Margin="20,0,10,0" x:Name="gridDescription" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="250" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Image x:Name="imgAnimal" Grid.Row="0" Stretch="Uniform" Margin="0,0,0,10"/>

                    <TextBlock x:Name="txtName" Grid.Row="1" FontWeight="Bold" FontSize="16" Margin="0,5"/>
                        
                 

                    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                        <StackPanel Orientation="Vertical">
                            <TextBlock x:Name="textDescription" TextWrapping="Wrap" LineHeight="20" />
                            <TextBlock Text="Интересный факт" TextWrapping="Wrap" LineHeight="20" FontWeight="Bold" FontSize="16" Margin="0,5"/>
                            <TextBlock x:Name="txtFacts" TextWrapping="Wrap" />
                        </StackPanel>
                        
                    </ScrollViewer>
                </Grid>
            </StackPanel>
        </TabItem>

    </TabControl>
</Window>