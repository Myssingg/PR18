<Window x:Class="BorDer_PR18_01._01.EditAnimal"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BorDer_PR18_01._01"
        mc:Ignorable="d"
        Title="EditAnimal" Height="auto" Width="800"
        FontFamily="Comic Sans MS" FontSize="14">
    <StackPanel Orientation="Vertical" HorizontalAlignment="Center">
        <TextBlock Text="Имя животного" HorizontalAlignment="Center" Padding="5"/>
        <TextBox Text="{Binding name}" 
             TextWrapping="Wrap" 
             Name="nameq"
             TextAlignment="Center" 
             FontWeight="SemiBold" 
             MaxWidth="150"
             HorizontalAlignment="Center"
                 Width="150"
                 Padding="5"
                 Background="#76E383"/>

        <TextBlock Text="Описание животного" HorizontalAlignment="Center" Padding="5"/>
        <TextBox Text="{Binding description}" 
                 TextWrapping="Wrap" 
                 x:Name="description"
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" 
                 Padding="5" 
                 Width="450"
                 MaxHeight="200"
                 TextChanged="description_TextChanged"
                 Background="#76E383"/>

        <TextBlock Text="Интересные факты" Padding="5" HorizontalAlignment="Center"/>
        <TextBox Text="{Binding facts}" 
                 x:Name="facts" 
                 TextWrapping="Wrap" 
                 TextAlignment="Center" 
                 FontWeight="SemiBold" 
                 HorizontalAlignment="Center" 
                 VerticalAlignment="Top" 
                 Width="450"
                 Padding="5"
                 TextChanged="facts_TextChanged"
                 Background="#76E383"/>

        <TextBlock Text="Изображение" Padding="5" HorizontalAlignment="Center"/>
        <ComboBox x:Name="Photo"  
                  Width="200" 
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  DisplayMemberPath="imageName"
                  SelectedValuePath="id" 
                  SelectionChanged="Photo_SelectionChanged"
                  Padding="5"/>
        <Image Source="{Binding imagePath}" 
               Width="181" 
               Height="181"
               x:Name="image"
               Stretch="Uniform" 
               Margin="10"/>

        <Button Content="Редактировать" 
                x:Name="button_create_edit" 
                Click="Button_Click" 
                HorizontalAlignment="Stretch" 
                Padding="5" 
                Width="200" 
                Margin="0,10,0,30"
                Background="#498C51"/>
    </StackPanel>
</Window>
